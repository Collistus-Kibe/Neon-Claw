# ==============================================================================
# NemoClaw Personal AI Environment Configuration
# ==============================================================================

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# User Authorization Whitelist (Comma-separated Telegram user IDs)
# Leave blank to allow any user in development mode
ALLOWED_TELEGRAM_USER_IDS=

# Nebius Serverless / Token Factory API Configuration
# Get your API key from https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Tailscale Peer-to-Peer Mesh (Optional for Laptop <-> Home Server Tunnel)
TAILSCALE_AUTH_KEY=
