# ==============================================================================
# NemoClaw Personal AI Environment Configuration
# ==============================================================================

# 1. Telegram Bot Interface (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. User Authorization Whitelist (Comma-separated Telegram user IDs from @userinfobot)
# Leave blank to allow any user in development mode
ALLOWED_TELEGRAM_USER_IDS=

# 3. NVIDIA Developer API Configuration (Recommended - from https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional Fallback: Nebius Serverless / Token Factory API
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

# 4. Tailscale Peer-to-Peer Mesh (Optional for Laptop <-> Home Server Tunnel)
TAILSCALE_AUTH_KEY=

# 5. Autonomous Email Management & Urgency Triage (IMAP & SMTP)
# Supports Gmail (use 16-character App Password), Outlook, iCloud, or custom mail server.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
